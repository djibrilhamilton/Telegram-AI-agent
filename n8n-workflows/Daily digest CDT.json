        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Today is {{ $now.toISO() }} CDT. Write a smart morning briefing for {{ $('Morning Loop').item.json.first_name }}.\\n\\nPending tasks:\\n{{ $('Fetch Morning Tasks').all().map(t => `[${t.json.category.toUpperCase()}] ${t.json.title} | due: ${t.json.deadline || 'no deadline'} | priority: ${t.json.priority}`).join('\\\\n') }}\\n\\nStructure:\\n1. 🔴 Overdue\\n2. 📅 Today — Business\\n3. 📅 Today — Personal\\n4. 👀 Coming up this week\\n5. 💡 Smart suggestion\\n\\nWarm, concise, emojis. Max 500 words.\"\n    }\n  ]\n}",
        "options": {}
      },
