    {
      "parameters": {
        "jsCode": "const users = $input.all();\nconst now = new Date();\nconst cdtTime = new Date(now.toLocaleString('en-US', { timeZone: 'America/Chicago' }));\nconst currentHour = cdtTime.getHours();\n\nconst morningUsers = [];\nconst eveningUsers = [];\n\nfor (const user of users) {\n  if (currentHour === 8) morningUsers.push(user.json);\n  if (currentHour === 19) eveningUsers.push(user.json);\n}\n\nreturn [{ json: { morningUsers, eveningUsers, currentHour } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
