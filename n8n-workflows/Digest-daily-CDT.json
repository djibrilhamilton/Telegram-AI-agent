      "name": "Get all users",
      "credentials": {
        "supabaseApi": {
          "id": "XXX",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const users = $input.all();\nconst now = new Date();\nconst cdtTime = new Date(now.toLocaleString('en-US', { timeZone: 'America/Chicago' }));\nconst currentHour = cdtTime.getHours();\n\nconst morningUsers = [];\nconst eveningUsers = [];\n\nfor (const user of users) {\n  if (currentHour === 7) morningUsers.push(user.json);\n  if (currentHour === 22) eveningUsers.push(user.json);\n}\n\nreturn [{ json: { morningUsers, eveningUsers, currentHour } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "a9552c38-0083-42c9-b923-eda81b9ef4cc",
      "name": "Filter by CDT hour"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "e0e773d0-80c7-4dc8-917d-f73fee6bbbbe",
              "leftValue": "={{ $json.morningUsers.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
