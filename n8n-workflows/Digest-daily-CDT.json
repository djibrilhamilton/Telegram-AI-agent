    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "XXX"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Today is {{ $now.toISO() }} CDT. Write a smart morning briefing for {{ $('Morning loop').item.json.first_name }}.\\n\\nPending tasks:\\n{{ $('Retrieve morning tasks').all().map(t => `[${t.json.category.toUpperCase()}] ${t.json.title} | due: ${t.json.deadline || 'no deadline'} | priority: ${t.json.priority}`).join('\\\\n') }}\\n\\nStructure:\\n1. 🔴 Overdue\\n2. 📅 Today — Business\\n3. 📅 Today — Personal\\n4. 👀 Coming up this week\\n5. 💡 Smart suggestion\\n\\nStrict rules:\\n- ONE single message only, never split\\n- Maximum 3-4 lines per task including its tip\\n- Weekly Strategy section maximum 4 sentences\\n- Use bullet points for tasks\\n- Warm, direct, encouraging tone with emojis\\n- Do not add extra sections beyond the structure above\\n- If there are many tasks, group similar ones instead of removing them.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
