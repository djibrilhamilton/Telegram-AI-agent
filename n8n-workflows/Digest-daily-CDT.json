    {
      "parameters": {
        "jsCode": "const user = $('Evening Loop').first().json;\nconst tasks = $input.all();\n\nif (tasks.length === 0) {\n  return [{ json: { message: `🌙 Good night ${user.first_name}! No pending tasks. Great work today! 🎉`, chatId: user.telegram_id } }];\n}\n\nlet msg = `🌙 *Evening Check-in — ${user.first_name}*\\n\\nStill pending:\\n\\n`;\nconst business = tasks.filter(t => t.json.category === 'business');\nconst personal = tasks.filter(t => t.json.category === 'personal');\n\nif (business.length > 0) {\n  msg += `🏢 *Business:*\\n`;\n  business.forEach(t => { msg += `• ${t.json.title}\\n`; });\n  msg += '\\n';\n}\nif (personal.length > 0) {\n  msg += `👤 *Personal:*\\n`;\n  personal.forEach(t => { msg += `• ${t.json.title}\\n`; });\n}\n\nmsg += `\\nHave a good night! 🌙`;\nreturn [{ json: { message: msg, chatId: user.telegram_id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
