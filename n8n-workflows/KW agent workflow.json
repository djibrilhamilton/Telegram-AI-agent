        "jsCode": "const reply = $('Telegram Trigger').first().json.message.text;\nconst taskIndex = parseInt(reply.trim()) - 1;\nconst tasks = $('Build Done List').first().json.tasks;\n\nif (isNaN(taskIndex) || taskIndex < 0 || taskIndex >= tasks.length) {\n  return [{ json: { error: true, message: \"❌ Invalid number. Please send /done and try again.\", taskId: null, title: null } }];\n}\n\nconst task = tasks[taskIndex];\nreturn [{ json: { error: false, taskId: task.id, title: task.title } }];"
