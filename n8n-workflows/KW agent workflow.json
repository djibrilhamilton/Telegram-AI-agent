        "jsCode": "const tasks = $input.all();\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nif (tasks.length === 0) {\n  return [{ json: { message: \"✅ No pending tasks to mark complete!\", chatId, empty: true } }];\n}\n\nlet msg = \"✅ *Which task did you complete?*\\nReply with the number:\\n\\n\";\ntasks.forEach((t, i) => {\n  const emoji = t.json.category === 'business' ? '🏢' : '👤';\n  const deadline = t.json.deadline ? ` — due ${t.json.deadline.split('T')[0]}` : '';\n  msg += `*${i + 1}.* ${emoji} ${t.json.title}${deadline}\\n`;\n});\n\nreturn [{\n  json: {\n    message: msg,\n    chatId,\n    tasks: tasks.map(t => t.json),\n    empty: false\n  }\n}];"
      },
