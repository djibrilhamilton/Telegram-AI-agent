    {
      "parameters": {
        "jsCode": "const tasks = $input.all();\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nif (tasks.length === 0) {\n  return [{ json: { message: \"✅ You have no pending tasks! Enjoy your day.\", chatId } }];\n}\n\nconst business = tasks.filter(t => t.json.category === 'business');\nconst personal = tasks.filter(t => t.json.category === 'personal');\n\nlet msg = `📋 *Your Pending Tasks (${tasks.length} total)*\\n\\n`;\n\nif (business.length > 0) {\n  msg += `🏢 *Business (${business.length})*\\n`;\n  business.forEach(t => {\n    const deadline = t.json.deadline ? ` — due ${t.json.deadline.split('T')[0]}` : '';\n    const priority = t.json.priority === 'high' ? '🔴' : t.json.priority === 'medium' ? '🟡' : '🟢';\n    msg += `${priority} ${t.json.title}${deadline}\\n`;\n  });\n  msg += '\\n';\n}\n\nif (personal.length > 0) {\n  msg += `👤 *Personal (${personal.length})*\\n`;\n  personal.forEach(t => {\n    const deadline = t.json.deadline ? ` — due ${t.json.deadline.split('T')[0]}` : '';\n    const priority = t.json.priority === 'high' ? '🔴' : t.json.priority === 'medium' ? '🟡' : '🟢';\n    msg += `${priority} ${t.json.title}${deadline}\\n`;\n  });\n}\n\nmsg += `\\n_🔴 high  🟡 medium  🟢 low_\\nUse /done to complete a task.`;\nreturn [{ json: { message: msg, chatId } }];"
      },
